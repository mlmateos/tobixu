#!/bin/sh
set -e
# Forzar gdm3 como display-manager
systemctl disable lightdm sddm 2>/dev/null || true
systemctl enable gdm3 || true
# Crear enlace simbólico
ln -sf /lib/systemd/system/gdm3.service /etc/systemd/system/display-manager.service
# Reiniciar display-manager si ya está corriendo
if systemctl is-active --quiet display-manager; then
    systemctl restart display-manager || true
fi
