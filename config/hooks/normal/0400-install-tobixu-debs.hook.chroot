#!/bin/sh
set -e
# Instala los paquetes de fabrica sembrados en /opt/tobixu-debs/ por CAPA2.
# Doctrina: los paquetes de identidad viven en /opt durante el build, no en el
# repo firmado (que el chroot no alcanza durante el horneado).
# dpkg -i es mas robusto que apt-get install: no verifica dependencias contra
# los repos (las dependencias ya estan instaladas via 010-desktop.list.chroot).

if [ -d /opt/tobixu-debs ] && ls /opt/tobixu-debs/*.deb >/dev/null 2>&1; then
    echo "=== 0400-install: instalando paquetes de fabrica ==="
    export DEBIAN_FRONTEND=noninteractive
    dpkg -i /opt/tobixu-debs/*.deb || apt-get install -f -y
    echo "=== 0400-install: paquetes instalados ==="
    dpkg -l | grep -E "tobixu-|tobi-xu-" | awk '{print $2, $3}'
    rm -rf /opt/tobixu-debs
    echo "=== 0400-install: /opt/tobixu-debs limpiado ==="
else
    echo "=== 0400-install: /opt/tobixu-debs vacio o ausente, nada que instalar ==="
fi
