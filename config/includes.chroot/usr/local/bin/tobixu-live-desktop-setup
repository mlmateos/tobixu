#!/bin/sh
# Velo en cualquier sistema con tobixu-wallpapers
WALL="$(dpkg -L tobixu-wallpapers 2>/dev/null | grep -m1 -E '\.(png|jpe?g)$')"
if [ -n "$WALL" ]; then
gsettings set org.gnome.desktop.background picture-uri "file://$WALL" 2>/dev/null || true
gsettings set org.gnome.desktop.background picture-uri-dark "file://$WALL" 2>/dev/null || true
fi
update-desktop-database /usr/share/applications 2>/dev/null || true
# Resto: solo sesion viva
grep -q "boot=live" /proc/cmdline || exit 0
sleep 5
gnome-extensions enable ding@rastersoft.com 2>/dev/null || true
mkdir -p "$HOME/Desktop"
[ -f "$HOME/Desktop/tobixu-install.desktop" ] || cp /usr/share/tobixu/tobixu-install.desktop "$HOME/Desktop/" 2>/dev/null || true
chmod 0755 "$HOME/Desktop/tobixu-install.desktop" 2>/dev/null || true
gio set "$HOME/Desktop/tobixu-install.desktop" metadata::trusted true 2>/dev/null || true
gsettings set org.gnome.tour ran true 2>/dev/null || true
# === TESTIGOS DE RUNTIME (v4.6): la sesion entrega el error por escrito ===
{ ptyxis --version > "$HOME/Desktop/test-ptyxis.txt" 2>&1 || echo "rc=$?" >> "$HOME/Desktop/test-ptyxis.txt"; }
exit 0
# Testigo full-run: si ptyxis vive 8s, su ventana debio verse; si muere, el stderr queda escrito
timeout 8 ptyxis > /dev/null 2> "$HOME/Desktop/test-ptyxis-full.txt"
echo "rc=$?" >> "$HOME/Desktop/test-ptyxis-full.txt"
