[Unit]
Description=TobiXu: usuario vivo (user/live) antes de GDM
ConditionKernelCommandLine=boot=live
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tobixu-live-user-create
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
