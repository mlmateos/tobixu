# Velo de arranque TobiXu (v0.1.0): orbita-noche estatica + glifo centrado.
Window.SetBackgroundTopColor(0.03, 0.10, 0.07);
Window.SetBackgroundBottomColor(0.01, 0.05, 0.04);

bg = Image("orbita-noche.png");
bg = bg.Scale(Window.GetWidth(), Window.GetHeight());
bg_sprite = Sprite(bg);
bg_sprite.SetPosition(0, 0, -10);

glifo = Image("glifo-256.png");
glifo_sprite = Sprite(glifo);
glifo_sprite.SetPosition(Window.GetWidth() / 2 - glifo.GetWidth() / 2,
                         Window.GetHeight() / 2 - glifo.GetHeight() / 2, 1);
